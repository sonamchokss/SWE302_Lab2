{
  "name": "cst-student-management-system",
  "version": "1.0.0",
  "description": "CST College Student Management System - SWE302 Lab 2",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node src/server.js",
    "test": "jest --coverage --testPathIgnorePatterns=/tests/db/",
    "test:db": "jest tests/db --runInBand"
  },
  "dependencies": {
    "express": "^4.19.2",
    "multer": "^1.4.5-lts.1",
    "pdfkit": "^0.15.0",
    "pg": "^8.11.5"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^10.9.0",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "testcontainers": "^10.9.0"
  },
  "jest": {
    "collectCoverageFrom": [
      "src/validators.js",
      "src/businessLogic.js"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 90,
        "branches": 85,
        "functions": 90,
        "lines": 90
      }
    },
    "modulePathIgnorePatterns": [
      "<rootDir>/jmeter-lab/"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/jmeter-lab/"
    ]
  }
}
